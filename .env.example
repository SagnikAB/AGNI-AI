# =============================================================================
# .env.example — AGNI-AI (SIH 2026 · PS 26162). Copy to `.env` and fill in
# your credentials. Never commit the real `.env` file — all secrets are read
# ONLY by config_keys.py (credential isolation rule).
# =============================================================================

# --- NASA FIRMS API key (REQUIRED for live data) -------------------------------
# Get a free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# (official FIRMS name for the credential is MAP_KEY)
MAP_KEY=

# --- Optional basemap provider -------------------------------------------------
# MapTiler token -> higher-quality raster tiles (https://cloud.maptiler.com)
# Leave empty to use free OpenStreetMap tiles (no key required).
MAPTILER_KEY=

# --- Server --------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Area of interest: west,south,east,north (WGS-84 degrees, FIRMS order) ------
# AGNI-AI is INDIA-BOUNDED (SIH PS 26162): default India subcontinent bbox.
# Narrow it only to a smaller sub-region INSIDE India — never wider.
AOI=68.0,6.0,97.0,37.0

# --- Data window & spatial scoping ----------------------------------------------
# Days of thermal history per fetch (FIRMS NRT maximum = 5 per call; a full
# 30-day persistence window requires an SP/archive source — see SRS §2.5)
PERSISTENCE_WINDOW_DAYS=5
# Radius (m) around anomalies used to query OSM industrial polygons
OSM_SEARCH_RADIUS_M=2000

# --- Classification thresholds (SRS §3.1.4, FR-CLS-06) ----------------------------
CLASS1_EVIDENCE_MIN=0.55
WILDFIRE_FRP_MIN_MW=6.0
WILDFIRE_BT_MIN_K=330

# --- HTTP resilience -------------------------------------------------------------
HTTP_TIMEOUT_S=30
MAX_RETRIES=3
RETRY_BACKOFF_BASE_S=2

# --- Cache / refresh lifecycle -----------------------------------------------------
REFRESH_TTL_MINUTES=15
REFRESH_MIN_INTERVAL_S=60

# --- Offline demo mode (no API key / no network needed) ----------------------------
# APP_DEMO_MODE=1 forces synthetic India data; auto-enabled when MAP_KEY is empty.
APP_DEMO_MODE=0
